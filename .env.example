# RoutePlanner - Ejemplo de variables de entorno
# Copiar a .env y ajustar valores: cp .env.example .env

# Flask
SECRET_KEY=dev-secret-key-change-in-production
ENCRYPTION_KEY=0A1glB0r_8tPpo8k9eeWZW3TXvkvCPpw1ZgBmsV5D6s=
CONFIG_ACCESS_KEY=admin
HOST=0.0.0.0
PORT=8003
FLASK_ENV=development
DEBUG=True
FLASK_APP=app.py

# Database - MySQL via docker-compose (requerido: mysql+pymysql)
# Ejemplo dev: DATABASE_URL=mysql+pymysql://route_user:route_password@db:3306/routeplanner
# Fallback local (sin Docker): sqlite:///routeplanner.db  -> se usa si DATABASE_URL vacío
DATABASE_URL=mysql+pymysql://route_user:route_password@db:3306/routeplanner

# MySQL (para docker-compose)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=routeplanner
MYSQL_USER=route_user
MYSQL_PASSWORD=route_password

# Admin por defecto (creado automáticamente por entrypoint.sh / seed.py)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@routeplanner.local
ADMIN_PASSWORD=Admin123!
# ADMIN_FORCE_RESET=false  # si true, resetea password en cada arranque

# Opcional APIs
# OPENWEATHER_API_KEY=
