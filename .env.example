# RoutePlanner - Environment variables example
# Copy to .env and adjust values: cp .env.example .env

# Flask
SECRET_KEY=dev-secret-key-change-in-production
ENCRYPTION_KEY=0A1glB0r_8tPpo8k9eeWZW3TXvkvCPpw1ZgBmsV5D6s=
CONFIG_ACCESS_KEY=admin
HOST=0.0.0.0
PORT=8003
FLASK_ENV=development
DEBUG=True
FLASK_APP=app.py

# Database
# - In Docker (compose) it is AUTOMATICALLY OVERRIDDEN to MySQL:
#   DATABASE_URL=mysql+pymysql://route_user:route_password@db:3306/routeplanner  (see docker-compose.yml:19)
# - Locally without Docker, leave empty or use SQLite so uv run app.py works without MySQL:
#   If DATABASE_URL is empty, config.py uses sqlite:///routeplanner.db (instance/routeplanner.db)
# For local with external MySQL uncomment the MySQL line:
# DATABASE_URL=mysql+pymysql://route_user:route_password@127.0.0.1:3306/routeplanner
DATABASE_URL=

# MySQL (for docker-compose)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=routeplanner
MYSQL_USER=route_user
MYSQL_PASSWORD=route_password

# Default admin (automatically created by entrypoint.sh / seed.py)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@routeplanner.local
ADMIN_PASSWORD=Admin123!
# ADMIN_FORCE_RESET=false  # if true, resets password on every startup

# Optional APIs
# OPENWEATHER_API_KEY=
