# RoutePlanner - Single image (SQLite by default)
# Copy to .env and adjust: cp .env.example .env

# Flask
SECRET_KEY=dev-secret-key-change-in-production
ENCRYPTION_KEY=0A1glB0r_8tPpo8k9eeWZW3TXvkvCPpw1ZgBmsV5D6s=
CONFIG_ACCESS_KEY=admin
HOST=0.0.0.0
PORT=8003
FLASK_ENV=production
DEBUG=False
FLASK_APP=app.py

# Database - SINGLE IMAGE DEFAULT IS SQLITE (no external DB needed)
# Leave empty to use SQLite (instance/routeplanner.db) - persisted via docker volume
DATABASE_URL=
# Optional: use external MySQL/PostgreSQL (drivers included: pymysql, psycopg2-binary)
# MySQL example:      DATABASE_URL=mysql+pymysql://route_user:route_password@host:3306/routeplanner
# PostgreSQL example: DATABASE_URL=postgresql+psycopg2://route_user:route_password@host:5432/routeplanner

# Default admin (auto-created by entrypoint.sh / seed.py)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@routeplanner.local
ADMIN_PASSWORD=Admin123!
# ADMIN_FORCE_RESET=false  # if true, resets password on every startup

# Optional APIs
# OPENWEATHER_API_KEY=
